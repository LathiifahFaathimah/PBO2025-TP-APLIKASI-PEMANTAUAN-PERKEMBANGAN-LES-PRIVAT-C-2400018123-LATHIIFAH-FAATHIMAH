// CetakLaporan
import java.io.PrintWriter;

public class CetakLaporan {

    public static void buatFile() {
        try {
            PrintWriter pw = new PrintWriter("laporan_les.txt");

            for (Murid m : DataLes.data) {
                pw.println(m.nama + " | " + m.statusMurid() +
                        " | nilai: " + m.nilaiAkhir() +
                        " | paket: " + m.paket.getNamaPaket());
            }
            pw.close();
        } catch (Exception e) {
            System.out.println("Tidak bisa cetak laporan");
        }
    }
}

// DataLes
import java.util.ArrayList;

public class DataLes {
    public static ArrayList<Murid> data = new ArrayList<>();

    public static void tambah(Murid m) {
        data.add(m);
    }

    public static void hapus(int index) {
        data.remove(index);
    }
}

// FileHelper
import java.io.*;

public class FileHelper {

    static String namaFile = "murid_les.txt";

    public static void simpan() {
        try {
            PrintWriter pw = new PrintWriter(namaFile);

            for (Murid m : DataLes.data) {
                pw.println(m.nama + "|" + m.hadir + "|" + m.nilai + "|" + m.paket.getNamaPaket());
            }
            pw.close();
        } catch (Exception e) {
            System.out.println("Gagal simpan data");
        }
    }

    public static void baca() {
        try {
            BufferedReader br = new BufferedReader(new FileReader(namaFile));
            String baris;

            while ((baris = br.readLine()) != null) {
                String[] d = baris.split("\\|");

                String nama = d[0];
                int hadir = Integer.parseInt(d[1]);
                int nilai = Integer.parseInt(d[2]);
                String p = d[3];

                Paket paket;
                if (p.contains("Intensif")) paket = new PaketIntensif();
                else paket = new PaketReguler();

                Murid m;
                if (hadir >= 75 && nilai >= 70)
                    m = new MuridAktif(nama, hadir, nilai, paket);
                else
                    m = new MuridPasif(nama, hadir, nilai, paket);

                DataLes.tambah(m);
            }

            br.close();
        } catch (Exception e) {
            // kalau file belum ada, biarkan
        }
    }
}

