    // ================= LOGIC =================
    private void simpanMurid() {
        try {
            String nama = txtNama.getText();
            int hadir = Integer.parseInt(txtHadir.getText());
            int nilai = Integer.parseInt(txtNilai.getText());

            Paket paket = rbIntensif.isSelected() ? new PaketIntensif() : new PaketReguler();

            Murid m;
            if (hadir >= 10 && nilai >= 75) {
                m = new MuridAktif(nama, hadir, nilai, paket);
            } else {
                m = new MuridPasif(nama, hadir, nilai, paket);
            }

            DataLes.tambah(m);
            FileHelper.simpan();
            refreshList();
            clearForm();

            JOptionPane.showMessageDialog(this, "Data murid berhasil disimpan");

        } catch (Exception e) {
            JOptionPane.showMessageDialog(this, "Input tidak valid");
        }
    }

    private void refreshList() {
        listModel.clear();
        for (Murid m : DataLes.data) {
            listModel.addElement(
                    m.nama + " | " + m.statusMurid() +
                            " | Hadir: " + m.hadir +
                            " | Nilai: " + m.nilai +
                            " | Paket: " + m.paket.getNamaPaket()
            );
        }
    }

    private void hapusMurid() {
        int index = listMurid.getSelectedIndex();
        if (index != -1) {
            DataLes.hapus(index);
            FileHelper.simpan();
            refreshList();
            JOptionPane.showMessageDialog(this, "Data murid berhasil dihapus");
        } else {
            JOptionPane.showMessageDialog(this, "Pilih data murid terlebih dahulu");
        }
    }

    private void clearForm() {
        txtNama.setText("");
        txtHadir.setText("");
        txtNilai.setText("");
        rbReguler.setSelected(true);
    }

    private void bukaFileLaporan() {
        try {
            File file = new File("laporan_les.txt");
            Desktop.getDesktop().open(file);
        } catch (Exception e) {
            JOptionPane.showMessageDialog(this, "File laporan tidak dapat dibuka");
        }
    }

    public static void main(String[] args) {
        new MainGUI().setVisible(true);
    }
}

// Murid
public abstract class Murid {

    String nama;
    int hadir;
    int nilai;
    Paket paket;

    public Murid(String n, int h, int v, Paket p) {
        nama = n;
        hadir = h;
        nilai = v;
        paket = p;
    }

    public String getNama() {
        return nama;
    }

    public abstract String statusMurid();

    public int nilaiAkhir() {
        return (hadir + nilai) / 2;
    }
}

// MuridAktif
public class MuridAktif extends Murid {
    public MuridAktif(String n, int h, int v, Paket p) {
        super(n, h, v, p);
    }

    @Override
    public String statusMurid() {
        return "Aktif";
    }
}

// MuridPasif
public class MuridPasif extends Murid {
    public MuridPasif(String n, int h, int v, Paket p) {
        super(n, h, v, p);
    }

    @Override
    public String statusMurid() {
        return "Tidak Aktif";
    }
}

// Paket
public interface Paket {
    String getNamaPaket();
    int harga();
}

// PaketReguler
public class PaketReguler implements Paket {

    public String getNamaPaket() {
        return "Reguler 2x seminggu";
    }

    public int harga() {
        return 300000;
    }
}

// PaketIntensif
public class PaketIntensif implements Paket {

    public String getNamaPaket() {
        return "Intensif 4x seminggu";
    }

    public int harga() {
        return 500000;
    }
}
